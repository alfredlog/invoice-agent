
# --- E-Mail-Zugang (IMAP) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=deine.adresse@gmail.com
IMAP_PASSWORD=dein_app_passwort   # NICHT dein normales Passwort! Siehe README.

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Verhalten des Agents ---
SEARCH_DAYS=30                    # wie viele Tage zurück gesucht wird
OUTPUT_FOLDER=./rechnungen         # Zielordner für gespeicherte PDFs
LOG_FILE=./invoices_log.csv        # Protokoll aller erkannten Rechnungen
